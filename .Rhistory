p_heterogeneity = p_het,
I2 = I2
)
return(result)
}
# 示例数据（请替换为 KEYNOTE-671 中 current 和 former 的实际值）
hr_vec <- c(0.52, 0.57)
lower_vec <- c(0.34, 0.43)
upper_vec <- c(0.78, 0.75)
res <- combine_hr_invvar(hr_vec, lower_vec, upper_vec)
cat(sprintf("合并 HR = %.3f (95%% CI: %.3f–%.3f)\n",
res$pooled_hr, res$ci_lower, res$ci_upper))
cat(sprintf("异质性检验: Q = %.3f, df = %d, p = %.4f, I² = %.1f%%\n",
res$Q, res$df, res$p_heterogeneity, res$I2))
# Mantel-Haenszel 法合并 HR (固定效应模型)
# 参数:
#   events_t : 各亚组治疗组事件数 (向量)
#   n_t      : 各亚组治疗组总人数 (向量)
#   events_c : 各亚组对照组事件数 (向量)
#   n_c      : 各亚组对照组总人数 (向量)
# 返回: 列表，包含合并 HR、CI 及异质性统计量
combine_hr_mh <- function(events_t, n_t, events_c, n_c) {
# 计算每个亚组的 HR (近似为 OR，事件率低时近似 HR)
hr_i <- (events_t / n_t) / (events_c / n_c)
hr_i[hr_i <= 0] <- 1e-6
# 计算 logHR 及其方差 (Greenland 公式)
log_hr_i <- log(hr_i)
var_i <- 1/events_t + 1/(n_t - events_t) + 1/events_c + 1/(n_c - events_c)
# 避免无穷大
var_i[!is.finite(var_i)] <- 1e6
# 逆方差加权 (MH 估计量近似)
w <- 1 / var_i
total_w <- sum(w)
pooled_log_hr <- sum(w * log_hr_i) / total_w
pooled_se <- sqrt(1 / total_w)
pooled_hr <- exp(pooled_log_hr)
ci_lower <- exp(pooled_log_hr - 1.96 * pooled_se)
ci_upper <- exp(pooled_log_hr + 1.96 * pooled_se)
# 异质性 Q 检验
Q <- sum(w * (log_hr_i - pooled_log_hr)^2)
df <- length(events_t) - 1
p_het <- pchisq(Q, df, lower.tail = FALSE)
I2 <- max(0, (Q - df) / Q) * 100
# 可选：直接计算 MH 合并 HR (不使用逆方差近似)
# 严格 MH 公式 (针对 OR)
numerator <- sum(events_t * (n_c - events_c) / (n_t + n_c))
denominator <- sum((n_t - events_t) * events_c / (n_t + n_c))
hr_mh_strict <- numerator / denominator
# 输出
result <- list(
pooled_hr = pooled_hr,
ci_lower = ci_lower,
ci_upper = ci_upper,
hr_mh_strict = hr_mh_strict,   # 严格 MH 估计量
Q = Q,
df = df,
p_heterogeneity = p_het,
I2 = I2
)
return(result)
}
# 示例数据 (请替换为 KEYNOTE-671 中的实际值)
# 假设 current: 治疗组事件 37, 总 96; 对照组事件 57, 总 103
# 假设 former:  治疗组事件 84, 总 247; 对照组事件 128, 总 250
events_t <- c(37, 84)
n_t      <- c(96, 247)
events_c <- c(57, 128)
n_c      <- c(103, 250)
res_mh <- combine_hr_mh(events_t, n_t, events_c, n_c)
cat(sprintf("合并 HR (逆方差加权) = %.3f (95%% CI: %.3f–%.3f)\n",
res_mh$pooled_hr, res_mh$ci_lower, res_mh$ci_upper))
cat(sprintf("严格 MH 估计量 = %.3f\n", res_mh$hr_mh_strict))
cat(sprintf("异质性: Q = %.3f, p = %.4f, I² = %.1f%%\n",
res_mh$Q, res_mh$p_heterogeneity, res_mh$I2))
shiny::runApp('inst/app')
# 更新亚组顺序（如果提供了 reactiveVal）
if (!is.null(selected_order_reactive)) {
current_order <- selected_order_reactive()
if (!(input$synth_name %in% current_order)) {
selected_order_reactive(c(current_order, input$synth_name))
}
}
