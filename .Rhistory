return("clinical_studies_data.xlsx")
}
# 4. 最后从已安装的包中查找（作为回退）
pkg_file <- system.file("extdata", "clinical_studies_data.xlsx", package = "AIMetaAnalysis")
if (pkg_file != "") return(pkg_file)
stop("无法找到 clinical_studies_data.xlsx 文件。")
}
