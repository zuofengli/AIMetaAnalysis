# 加载所需包
library(tidyverse)
# 加载所需包
library(tidyverse)
# 选择一个离你较近的镜像，例如清华大学镜像源
options(repos = c(CRAN = "https://mirrors.tuna.tsinghua.edu.cn/CRAN/"))
renv::install("devtools")
renv::install(c("tidyverse"))
# 加载所需包
library(tidyverse)
library(meta)
# 假设您的数据框名为 df，包含以下关键列：
# study_id, trial, treatment, d, n, subgroup_option, grade
# 注意：treatment 中 "Nivolumab_Neoadj", "Nivolumab_Periop", "Tislelizumab_Periop" 均为ICI组，
#       "Chemotherapy_ctrl" 为对照组。grade 需为 "Overall"（确保是总体人群的亚组数据）。
# 数据预处理：标准化年龄组标签，只保留总体（grade == "Overall"）的记录
df_clean <- df %>%
filter(grade == "Overall") %>%
mutate(
# 统一年龄组名称：将 "lessThan_65 yr" 和 "lessThan_65yr" 统一为 "<65"
# 将 "moreEqualThan_65yr" 和 "moreEqualThan_65 yr" 统一为 ">=65"
age_group = case_when(
str_detect(subgroup_option, "lessThan_65") ~ "<65",
str_detect(subgroup_option, "moreEqualThan_65") ~ ">=65",
TRUE ~ NA_character_
),
# 区分ICI组和化疗组
arm = if_else(str_detect(treatment, "Chemotherapy"), "ctrl", "ICI")
) %>%
filter(!is.na(age_group))  # 移除无法识别年龄组的记录
