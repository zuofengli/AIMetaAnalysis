generate_latex_table <- function(df, eff_type, file) {
# 1. 准备数据
mat <- as.matrix(df[, -1, drop = FALSE])
rownames(mat) <- df[[1]]
colnames(mat) <- df[[1]]
# 2. 构建 gt 表格（仅用于生成 tabular，不用 table 环境）
gt_tbl <- mat %>%
as.data.frame() %>%
gt(rownames_to_stub = TRUE) %>%
tab_options(
table.width = pct(100),
column_labels.font.weight = "bold",
data_row.padding = px(3)
) %>%
# 不添加标题（由主文档的 \caption 控制）
# 不设置字体大小（由主文档的 \small 控制）
cols_align(align = "center", columns = everything()) %>%
tab_style(
style = cell_text(align = "left"),
locations = cells_stub()
)
# 3. 显著单元格红色加粗（使用 \textcolor{red} 避免依赖 HTML 颜色选项）
for (i in seq_len(nrow(mat))) {
for (j in seq_len(ncol(mat))) {
cell_text <- mat[i, j]
if (is_significant_cell(cell_text, eff_type)) {
gt_tbl <- gt_tbl %>%
tab_style(
style = list(cell_text(color = "red", weight = "bold")),
locations = cells_body(columns = colnames(mat)[j], rows = i)
)
}
}
}
# 4. 生成完整的 LaTeX 代码
latex_full <- as_latex(gt_tbl) %>% as.character()
# 5. 提取 tabular 环境（去除外层 table 环境及 caption、centering 等）
# 方法：找到 \begin{tabular} 和 \end{tabular}，保留它们及其之间的内容
tabular_pattern <- "(\\\\begin\\{tabular\\*?\\}.*?\\\\end\\{tabular\\*?\\})"
tabular_match <- regmatches(latex_full, regexpr(tabular_pattern, latex_full, perl = TRUE, ignore.case = FALSE))
if (length(tabular_match) == 0) {
# 降级：手动移除 \begin{table}...\end{table}，只保留中间的 tabular
# 先按行拆分，找到 \begin{table} 和 \end{table} 之间的行
lines <- strsplit(latex_full, "\n")[[1]]
start <- grep("\\\\begin\\{table\\}", lines)
end   <- grep("\\\\end\\{table\\}", lines)
if (length(start) > 0 && length(end) > 0) {
# 跳过 \begin{table} 和 \end{table} 行，并移除 \centering 和 \caption 行
keep <- lines[(start + 1):(end - 1)]
keep <- keep[!grepl("\\\\centering|\\\\caption", keep)]
# 移除可能的 \fontsize 行（如果有）
keep <- keep[!grepl("\\\\fontsize", keep)]
tabular_match <- paste(keep, collapse = "\n")
} else {
# 如果还不行，直接使用全部代码
tabular_match <- latex_full
}
}
# 6. 写入 .tex 文件（仅含 tabular 环境）
writeLines(tabular_match, con = file)
}
