runApp('inst/app/app_binary_data_extraction')
runApp('inst/app/app_binary_data_extraction')
runApp('inst/app/app_binary_data_extraction')
runApp('inst/app')
shiny::runApp('inst/app')
runApp('inst/app/app_binary_data_extraction')
runApp('inst/app')
runApp('inst/app')
runApp()
runApp()
