server <- function(input, output, session) {
# 所有可选项（可根据需要修改）
original <- reactiveVal(LETTERS[1:8])
# 右侧列表（顺序即为显示顺序）
right <- reactiveVal(character(0))
# 更新左侧列表（排除已加入右侧的项）
observe({
left_choices <- setdiff(original(), right())
updateSelectInput(session, "left", choices = left_choices)
})
# 更新右侧列表（保持顺序）
observe({
updateSelectInput(session, "right", choices = right())
})
# 加入：将左侧选中项追加到右侧末尾
observeEvent(input$add, {
req(input$left, input$left != "")
selected <- input$left
current_right <- right()
if (!(selected %in% current_right)) {
new_right <- c(current_right, selected)
right(new_right)
# 自动选中新加入的项
updateSelectInput(session, "right", selected = selected)
}
})
# 移除：从右侧删除选中项
observeEvent(input$remove, {
req(input$right, input$right != "")
selected <- input$right
current_right <- right()
new_right <- current_right[current_right != selected]
right(new_right)
# 清除右侧选中状态
updateSelectInput(session, "right", selected = character(0))
})
# 上升：将右侧选中项与上一项交换位置
observeEvent(input$up, {
req(input$right, input$right != "")
selected <- input$right
current_right <- right()
idx <- which(current_right == selected)
if (length(idx) == 1 && idx > 1) {
new_right <- current_right
new_right[idx] <- current_right[idx - 1]
new_right[idx - 1] <- selected
right(new_right)
# 保持选中该项
updateSelectInput(session, "right", selected = selected)
}
})
# 下降：将右侧选中项与下一项交换位置
observeEvent(input$down, {
req(input$right, input$right != "")
selected <- input$right
current_right <- right()
idx <- which(current_right == selected)
if (length(idx) == 1 && idx < length(current_right)) {
new_right <- current_right
new_right[idx] <- current_right[idx + 1]
new_right[idx + 1] <- selected
right(new_right)
updateSelectInput(session, "right", selected = selected)
}
})
}
shinyApp(ui, server)
runApp('inst/app')
