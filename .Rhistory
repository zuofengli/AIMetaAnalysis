res
string(res)
res
str(res)
league_table <- reactive({
res <- nma_result()
if (is.null(res) || is.null(res$setup)) {
return(NULL)
}
eform_flag <- TRUE
if (res$type == "binary" && !is.null(res$measure) && res$measure == "RD") {
eform_flag <- FALSE
}
# 直接对 setup 对象调用 nmaleague（与示例 nmaleague(smk2, ...) 一致）
league <- tryCatch(
NMA::nmaleague(res$setup, method = input$nma_method, eform = eform_flag),
error = function(e) {
showNotification(paste("联赛表生成失败：", e$message), type = "error")
NULL
}
)
if (is.null(league)) return(NULL)
# 统一转换为 data.frame，保证第一列为 Treatment
if (is.matrix(league)) {
trt_names <- rownames(league)
league_df <- as.data.frame(league, stringsAsFactors = FALSE)
league_df <- cbind(Treatment = trt_names, league_df)
rownames(league_df) <- NULL
league_df
} else if (is.data.frame(league)) {
if (!"Treatment" %in% colnames(league)) {
rn <- rownames(league)
if (!is.null(rn) && length(rn) == nrow(league)) {
league <- cbind(Treatment = rn, league)
rownames(league) <- NULL
} else {
league <- cbind(Treatment = seq_len(nrow(league)), league)
}
}
league
} else {
NULL
}
})
