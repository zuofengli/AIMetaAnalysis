)
# 添加自定义统计文本
if (input$model == "fixed") {
z_val <- round(m$zval.fixed, 2)
p_val <- m$pval.fixed
} else {
z_val <- round(m$zval.random, 2)
p_val <- m$pval.random
}
p_text <- ifelse(p_val < 0.0001, "<0.0001", paste0("= ", round(p_val, 4)))
I2_val <- round(m$I2, 1)
tau2_val <- round(m$tau2, 4)
p_Q <- m$pval.Q
df_val <- m$k - 1
p_Q_text <- ifelse(p_Q < 0.0001, "<0.0001", paste0("= ", round(p_Q, 4)))
het_text <- paste0("Heterogeneity: I² = ", I2_val, "%, τ² = ", tau2_val,
", p ", p_Q_text, ", df = ", df_val)
effect_text <- paste0("Test for overall effect (",
ifelse(input$model == "fixed", "Fixed effect", "Random effects"),
"): Z = ", z_val, " (", p_text, ")")
grid.text(het_text, x = 0.5, y = 0.05, just = "center",
gp = gpar(fontsize = 8))
grid.text(effect_text, x = 0.5, y = 0.02, just = "center",
gp = gpar(fontsize = 8))
})
# 显示合并结果的文字摘要
output$summary <- renderPrint({
m <- meta_result()
req(m)
if (input$model == "fixed") {
cat("固定效应模型\n")
cat("合并 OR: ", round(exp(m$TE.fixed), 2), "\n")
cat("95% CI: [", round(exp(m$lower.fixed), 2), ", ", round(exp(m$upper.fixed), 2), "]\n")
cat("Z = ", round(m$zval.fixed, 2), ", p = ", format.pval(m$pval.fixed, digits = 4), "\n")
} else {
cat("随机效应模型\n")
cat("合并 OR: ", round(exp(m$TE.random), 2), "\n")
cat("95% CI: [", round(exp(m$lower.random), 2), ", ", round(exp(m$upper.random), 2), "]\n")
cat("Z = ", round(m$zval.random, 2), ", p = ", format.pval(m$pval.random, digits = 4), "\n")
}
cat("\n异质性:\n")
cat("I² = ", round(m$I2, 1), "%\n")
cat("τ² = ", round(m$tau2, 4), "\n")
cat("Q = ", round(m$Q, 2), ", df = ", m$k - 1, ", p = ", format.pval(m$pval.Q, digits = 4), "\n")
})
}
# ---------- 4. 运行应用 ----------
shinyApp(ui = ui, server = server)
cat("Z = ", round(m$zval.fixed, 2), ", p = ", format.pval(m$pval.fixed, digits = 4), "\n")
# ==================== 改进版 Shiny 荟萃分析工具 ====================
# 功能：
#   - 上方表格展示研究信息，支持按分期、年份筛选
#   - 点击行选择研究（可多选）
#   - 下方运行固定/随机效应荟萃分析，显示森林图和统计结果
# 内置 8 项 NSCLC 免疫围手术期试验的 pCR 数据
library(shiny)
library(DT)
library(meta)
library(grid)
# ---------- 1. 准备数据 ----------
# 研究基本信息表（用于筛选和展示）
studies_info <- data.frame(
study = c("CheckMate 816", "KEYNOTE-671", "AEGEAN", "NEOTORCH",
"CheckMate 77T", "RATIONALE-315", "NADIM II", "TD-FOREKNOW"),
phase = c("III", "III", "III", "III", "III", "III", "II", "II"),
year = c(2022, 2024, 2023, 2024, 2024, 2024, 2023, 2023),
stage_included = c("IB-IIIA", "II-IIIB", "II-IIIB", "III", "II-IIIB", "II-IIIA", "III", "III"),
stringsAsFactors = FALSE
)
# pCR 数据（与 study 列关联）
pcr_data <- data.frame(
study = studies_info$study,
event_ici = c(43, 72, 63, 50, 58, 92, 21, 14),
n_ici     = c(179, 397, 366, 202, 229, 226, 57, 43),
event_ctrl = c(4, 16, 16, 2, 11, 13, 2, 4),
n_ctrl     = c(179, 400, 374, 202, 232, 227, 29, 45)
)
# ---------- 2. UI ----------
ui <- fluidPage(
titlePanel("NSCLC 围手术期免疫治疗 pCR 荟萃分析"),
# 上方：筛选和表格区域
wellPanel(
h4("1. 筛选临床研究"),
fluidRow(
column(4,
selectInput("phase_filter", "试验分期",
choices = c("全部", unique(studies_info$phase)),
selected = "全部")
),
column(4,
sliderInput("year_filter", "发表年份范围",
min = min(studies_info$year),
max = max(studies_info$year),
value = range(studies_info$year),
step = 1, sep = "")
)
),
br(),
h4("2. 选择研究（点击行可多选）"),
DTOutput("study_table")
),
# 下方：分析和结果区域
wellPanel(
h4("3. 分析设置"),
fluidRow(
column(3,
radioButtons("model", "效应模型",
choices = c("固定效应" = "fixed",
"随机效应" = "random"),
selected = "fixed")
),
column(3,
br(),
actionButton("run", "运行荟萃分析", icon = icon("play"),
class = "btn-primary")
)
),
br(),
h4("4. 森林图"),
plotOutput("forest_plot", height = "600px"),
br(),
h4("5. 合并结果"),
verbatimTextOutput("summary")
)
)
# ---------- 3. Server ----------
server <- function(input, output, session) {
# 根据筛选条件生成反应性数据
filtered_studies <- reactive({
df <- studies_info
if (input$phase_filter != "全部") {
df <- df[df$phase == input$phase_filter, ]
}
df <- df[df$year >= input$year_filter[1] &
df$year <= input$year_filter[2], ]
df
})
# 渲染研究表格
output$study_table <- renderDT({
datatable(filtered_studies(),
selection = 'multiple',      # 允许行多选
options = list(
pageLength = 10,
autoWidth = TRUE,
dom = 'ftp'
),
rownames = FALSE
)
})
# 获取选中的研究名称
selected_studies <- reactive({
rows <- input$study_table_rows_selected
if (is.null(rows)) {
return(NULL)
} else {
filtered_studies()[rows, "study"]
}
})
# 运行荟萃分析（点击按钮后执行）
meta_result <- eventReactive(input$run, {
req(selected_studies())
# 确保至少选择了两项研究
if (length(selected_studies()) < 2) {
showNotification("请至少选择两项研究进行分析", type = "error")
return(NULL)
}
# 从 pcr_data 中提取选中研究的数据
data <- pcr_data[pcr_data$study %in% selected_studies(), ]
# 按真实 OR 排序（使森林图按 OR 大小排列）
data$OR_true <- (data$event_ici * (data$n_ctrl - data$event_ctrl)) /
((data$n_ici - data$event_ici) * data$event_ctrl)
data <- data[order(data$OR_true, decreasing = FALSE), ]
data$OR_true <- NULL
metabin(event.e = event_ici, n.e = n_ici,
event.c = event_ctrl, n.c = n_ctrl,
studlab = study,
data = data,
sm = "OR",
method = "MH",
fixed = (input$model == "fixed"),
random = (input$model == "random"))
})
# 绘制森林图
output$forest_plot <- renderPlot({
m <- meta_result()
req(m)
# 基础森林图
forest(m,
leftcols = c("studlab", "event.e", "n.e", "event.c", "n.c", "w.fixed"),
leftlabs = c("Study", "ICI\nEvents", "ICI\nTotal", "Control\nEvents", "Control\nTotal", "Weight\n(fixed)"),
rightcols = c("effect.ci"),
rightlabs = "Odds Ratio for pCR",
smlab = "",
pooled.totals = TRUE,
pooled.events = TRUE,
comb.fixed = (input$model == "fixed"),
comb.random = (input$model == "random"),
hetstat = FALSE,          # 关闭默认异质性显示，自定义添加
fontsize = 9,
squaresize = 0.6,
col.square = "navy",
col.diamond = "maroon",
col.diamond.lines = "maroon"
)
# 添加自定义统计文本
if (input$model == "fixed") {
z_val <- round(m$zval.fixed, 2)
p_val <- m$pval.fixed
} else {
z_val <- round(m$zval.random, 2)
p_val <- m$pval.random
}
p_text <- ifelse(p_val < 0.0001, "<0.0001", paste0("= ", round(p_val, 4)))
I2_val <- round(m$I2, 1)
tau2_val <- round(m$tau2, 4)
p_Q <- m$pval.Q
df_val <- m$k - 1
p_Q_text <- ifelse(p_Q < 0.0001, "<0.0001", paste0("= ", round(p_Q, 4)))
het_text <- paste0("Heterogeneity: I² = ", I2_val, "%, τ² = ", tau2_val,
", p ", p_Q_text, ", df = ", df_val)
effect_text <- paste0("Test for overall effect (",
ifelse(input$model == "fixed", "Fixed effect", "Random effects"),
"): Z = ", z_val, " (", p_text, ")")
grid.text(het_text, x = 0.5, y = 0.05, just = "center",
gp = gpar(fontsize = 8))
grid.text(effect_text, x = 0.5, y = 0.02, just = "center",
gp = gpar(fontsize = 8))
})
# 显示合并结果的文字摘要
output$summary <- renderPrint({
m <- meta_result()
req(m)
if (input$model == "fixed") {
cat("固定效应模型\n")
cat("合并 OR: ", round(exp(m$TE.fixed), 2), "\n")
cat("95% CI: [", round(exp(m$lower.fixed), 2), ", ", round(exp(m$upper.fixed), 2), "]\n")
cat("Z = ", round(m$zval.fixed, 2), ", p = ", format.pval(m$pval.fixed, digits = 4), "\n")
} else {
cat("随机效应模型\n")
cat("合并 OR: ", round(exp(m$TE.random), 2), "\n")
cat("95% CI: [", round(exp(m$lower.random), 2), ", ", round(exp(m$upper.random), 2), "]\n")
cat("Z = ", round(m$zval.random, 2), ", p = ", format.pval(m$pval.random, digits = 4), "\n")
}
cat("\n异质性:\n")
cat("I² = ", round(m$I2, 1), "%\n")
cat("τ² = ", round(m$tau2, 4), "\n")
cat("Q = ", round(m$Q, 2), ", df = ", m$k - 1, ", p = ", format.pval(m$pval.Q, digits = 4), "\n")
})
}
# ---------- 4. 运行应用 ----------
shinyApp(ui = ui, server = server)
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
runApp('inst/app')
