.onLoad <- function(libname, pkgname) {
ensureInitialized()
.globals$next_id <- 0L
# Store a ref to the global loop so it doesn't get GC'd.
.globals$global_loop <- create_loop(parent = NULL)
}
library(shiny)
library(dplyr)
library(tidyr)
library(shinyjs)
syntheticUI <- function(id) {
ns <- NS(id)
tagList(
actionButton(ns("synthetic_btn"), "合成数据 *", icon = icon("plus-circle"), width = "100%")
)
}
syntheticServer <- function(id,
available_levels,           # reactive: 原始亚组水平
data_type,                  # reactive: "binary" 或 "survival"
base_data,                  # reactive: 原始数据（不含合成）
selected_order_reactive,    # reactiveVal: 亚组顺序
synthetic_data_reactive     # reactiveVal: 已存储的合成数据
) {
moduleServer(id, function(input, output, session) {
ns <- session$ns
# 控制按钮启用/禁用
observe({
req(available_levels())
if (length(available_levels()) == 0) {
shinyjs::disable("synthetic_btn")
} else {
shinyjs::enable("synthetic_btn")
}
})
# 用于存储待确认的合成参数（预留扩展）
pending_synth <- reactiveVal(NULL)
# 弹出模态框
observeEvent(input$synthetic_btn, {
req(available_levels())
updateSelectizeInput(session, "synth_name",
choices = available_levels(),
selected = "Combined",
options = list(create = TRUE, placeholder = "请选择或输入新名称"))
showModal(
modalDialog(
title = "合成新的亚组水平",
fluidRow(
column(6,
selectInput(ns("synth_levels"), "选择要合并的水平（可多选）",
choices = available_levels(),
multiple = TRUE, size = 8, selectize = FALSE)
),
column(6,
radioButtons(ns("synth_method"), "合并方法",
choices = c("逆方差加权法" = "invvar",
"Mantel-Haenszel 法" = "mh"),
selected = "invvar"),
selectizeInput(ns("synth_name"), "新水平名称",
choices = available_levels(),
selected = "Combined",
options = list(create = TRUE, placeholder = "请选择或输入新名称")),
helpText("注意：生存数据仅支持逆方差加权法。如果选择已存在的名称，将追加数据（不会覆盖原有数据）。")
)
),
footer = tagList(
modalButton("取消"),
actionButton(ns("confirm_synth"), "确认合成", class = "btn-primary")
),
easyClose = FALSE
)
)
})
# 逆方差加权合并函数（生存数据）
combine_survival_invvar <- function(df_levels) {
w <- 1 / (df_levels$se_te^2)
te_comb <- sum(w * df_levels$te) / sum(w)
se_comb <- sqrt(1 / sum(w))
data.frame(te = te_comb, se_te = se_comb,
n1 = NA_real_, n2 = NA_real_,
stringsAsFactors = FALSE)
}
# 执行合成的主函数（支持追加合并）
perform_synthesis <- function(selected_levels, new_name, method) {
base_df <- base_data()
# ========== 防御性检查 ==========
if (is.null(base_df)) {
showNotification("基础数据为空，无法进行合成。", type = "error")
return()
}
if (!"subgroup_level" %in% names(base_df)) {
showNotification("当前数据不支持亚组合成（缺少 subgroup_level 列）", type = "error")
return()
}
if (nrow(base_df) == 0) {
showNotification("基础数据为空，无法进行合成。", type = "warning")
return()
}
# 获取合成数据（如果为 NULL 则转为空数据框）
synth_data <- synthetic_data_reactive()
if (is.null(synth_data)) {
synth_data <- data.frame()
}
# 筛选要合并的水平数据
synth_df <- base_df %>% filter(subgroup_level %in% selected_levels)
if (nrow(synth_df) == 0) {
showNotification("所选水平下没有可用数据。", type = "warning")
return()
}
# 合并（仅支持逆方差加权，MH 法会提示并切换）
if (method == "mh") {
showNotification("生存数据推荐使用逆方差加权法，已自动切换。", type = "warning")
}
merged_by_study <- synth_df %>%
group_by(study_id, study_display) %>%
group_modify(~ combine_survival_invvar(.x)) %>%
ungroup() %>%
mutate(subgroup_level = new_name)
if (nrow(merged_by_study) == 0) {
showNotification("合并失败，请检查数据。", type = "error")
return()
}
# 处理已存在的同名水平（追加合并，而非覆盖）
existing_original <- new_name %in% available_levels()
existing_synth <- new_name %in% synth_data$subgroup_level
if (existing_original || existing_synth) {
# 获取已存在的该水平数据（原始 + 合成）
existing_raw <- base_df %>% filter(subgroup_level == new_name) %>%
select(study_id, study_display, te, se_te, n1, n2) %>%
mutate(source = "raw")
existing_synth_df <- synth_data %>%
filter(subgroup_level == new_name) %>%
select(study_id, study_display, te, se_te, n1, n2) %>%
mutate(source = "synth")
# 合并原始和已有合成数据，每个研究只保留一条（优先保留合成数据）
existing_data <- bind_rows(existing_raw, existing_synth_df) %>%
group_by(study_id) %>%
arrange(desc(source == "synth")) %>%  # 让合成数据排在前面
slice(1) %>%
ungroup() %>%
select(-source)
# 新合成的数据中，排除那些已经存在于 existing_data 中的研究
merged_by_study <- merged_by_study %>%
anti_join(existing_data, by = "study_id")
# 合并后得到完整的该水平数据
final_level_data <- bind_rows(existing_data, merged_by_study) %>%
mutate(subgroup_level = new_name)
} else {
final_level_data <- merged_by_study
}
# 更新合成数据存储：移除旧版本（如果存在），然后添加合并后的数据
old_synth <- synth_data %>% filter(subgroup_level != new_name)
synthetic_data_reactive(bind_rows(old_synth, final_level_data))
# 自动从用户顺序中移除被合并的原始水平（如果它们还在顺序中）
current_order <- selected_order_reactive()
new_order <- current_order[!current_order %in% selected_levels]
# 确保新水平在顺序中（如果尚未存在）
if (!(new_name %in% new_order)) {
new_order <- c(new_order, new_name)
}
selected_order_reactive(new_order)
showNotification(paste0("成功合成新水平：", new_name), type = "message")
}
# 确认合成（不再弹出覆盖确认，直接执行）
observeEvent(input$confirm_synth, {
req(input$synth_levels, length(input$synth_levels) >= 2)
req(data_type() == "survival")
req(base_data())  # 确保基础数据非空（但 base_data 可能为空数据框，后续会进一步检查）
new_name <- input$synth_name
selected_levels <- input$synth_levels
# 如果新名称在所选水平中，则不允许（不能自己合成自己）
if (new_name %in% selected_levels) {
showNotification("新水平名称不能与要合并的任一水平相同。", type = "error")
return()
}
# 直接执行合成（内部已处理追加合并）
perform_synthesis(selected_levels, new_name, input$synth_method)
# 关闭模态框
removeModal()
})
return(list(new_level = reactive({ input$synth_name })))
})
}
